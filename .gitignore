# BMAD personal configuration; shared skills and artifacts remain tracked.
/_bmad/config.user.toml
/_bmad/custom/**/*.user.toml

# Python bytecode and test/tool caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/

# Local Python virtual environments
.venv/
venv/
env/
.env/

# Local environment secrets; sanitized examples may be shared.
.env
.env.*
!.env.example
!.env.*.example

# Private key containers
*.key
*.p12
*.pfx
id_rsa
id_ed25519
