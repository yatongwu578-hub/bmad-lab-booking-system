diff --git a/equipment/test_create_navigation.py b/equipment/test_create_navigation.py
new file mode 100644
--- /dev/null
+++ b/equipment/test_create_navigation.py
@@ -0,0 +1,95 @@
+from html.parser import HTMLParser
+
+from django.test import Client, TestCase
+from django.urls import reverse
+
+from accounts.models import Role, User
+
+from .models import Equipment
+
+
+class _Links(HTMLParser):
+    def __init__(self):
+        super().__init__()
+        self.hrefs = []
+
+    def handle_starttag(self, tag, attrs):
+        if tag == "a":
+            self.hrefs.append(dict(attrs).get("href"))
+
+
+class EquipmentCreateNavigationTests(TestCase):
+    @classmethod
+    def setUpTestData(cls):
+        cls.admin = User.objects.create_user(username="nav-admin", role=Role.ADMIN)
+        cls.student = User.objects.create_user(username="nav-student", role=Role.STUDENT)
+        cls.teacher = User.objects.create_user(
+            username="nav-teacher", role=Role.TEACHER, is_staff=True, is_superuser=True,
+        )
+        cls.inactive_admin = User.objects.create_user(
+            username="nav-inactive", role=Role.ADMIN, is_active=False,
+        )
+
+    def setUp(self):
+        self.identity = reverse("identity")
+        self.catalog = reverse("equipment-catalog")
+        self.create = reverse("equipment-create")
+
+    def assert_create_link_opens_form(self, page):
+        self.assertContains(page, f'<a href="{self.create}">新增设备</a>', count=1, html=True)
+        links = _Links()
+        links.feed(page.content.decode(page.charset))
+        href = next(href for href in links.hrefs if href == self.create)
+        form = self.client.get(href)
+        self.assertEqual(form.status_code, 200)
+        self.assertTemplateUsed(form, "equipment/create_form.html")
+        self.assertContains(form, "新增具体设备档案")
+        self.assertContains(form, 'name="csrfmiddlewaretoken"')
+
+    def test_active_admin_can_follow_create_link_from_identity_and_catalog(self):
+        item = Equipment.objects.create(number="NAV-001", name="导航测试设备", category="测试", location="测试区")
+        self.client.force_login(self.admin)
+        identity = self.client.get(self.identity)
+        self.assertContains(identity, f'href="{self.catalog}"')
+        self.assert_create_link_opens_form(identity)
+        catalog = self.client.get(self.catalog)
+        self.assertContains(catalog, f'href="{reverse("equipment-detail", args=[item.pk])}"')
+        self.assert_create_link_opens_form(catalog)
+        self.assertEqual(list(Equipment.objects.values_list("pk", flat=True)), [item.pk])
+
+    def test_active_admin_can_follow_create_link_from_empty_catalog(self):
+        self.assertFalse(Equipment.objects.exists())
+        self.client.force_login(self.admin)
+        page = self.client.get(self.catalog)
+        self.assertContains(page, "暂无设备")
+        self.assert_create_link_opens_form(page)
+        self.assertFalse(Equipment.objects.exists())
+
+    def test_student_and_teacher_keep_read_navigation_but_cannot_create(self):
+        for user in (self.student, self.teacher):
+            with self.subTest(role=user.role):
+                client = Client()
+                client.force_login(user)
+                identity = client.get(self.identity)
+                catalog = client.get(self.catalog)
+                self.assertContains(identity, f'href="{self.catalog}"')
+                self.assertContains(catalog, f'href="{self.identity}"')
+                for page in (identity, catalog):
+                    self.assertNotContains(page, "新增设备")
+                    self.assertNotContains(page, f'href="{self.create}"')
+                response = client.get(self.create)
+                self.assertNotContains(response, "新增具体设备档案", status_code=403)
+        self.assertFalse(Equipment.objects.exists())
+
+    def test_anonymous_and_inactive_admin_are_redirected_to_login(self):
+        login = reverse("login")
+        for user in (None, self.inactive_admin):
+            with self.subTest(inactive_admin=user is not None):
+                client = Client()
+                if user is not None:
+                    client.force_login(user)
+                for path in (self.identity, self.catalog, self.create):
+                    response = client.get(path)
+                    self.assertRedirects(response, f"{login}?next={path}", fetch_redirect_response=False)
+                    self.assertNotContains(response, "新增设备", status_code=302)
+        self.assertFalse(Equipment.objects.exists())
